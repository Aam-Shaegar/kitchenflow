FROM golang:1.25.6-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /kitchen-api ./cmd/kitchen-api

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app

COPY --from=builder /kitchen-api .
COPY migrations ./migrations

EXPOSE 8080

ENV LOGGER_FOLDER=/app/logs
ENV LOGGER_LEVEL=DEBUG
ENV DATABASE_URL=postgres://postgres:postgres@postgres:5432/kitchen?sslmode=disable
ENV DB_TIMEOUT=10s
ENV SERVER_ADDR=:8080
ENV SHUTDOWN_TIMEOUT=30s
ENV TIME_ZONE=UTC
ENV RESTAURANT_MOCK_URL=http://restaurant-mock:8081
ENV KITCHEN_CALLBACK_URL=http://kitchen-api:8080

ENTRYPOINT ["/app/kitchen-api"]