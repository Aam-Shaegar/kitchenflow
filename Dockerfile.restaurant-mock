FROM golang:1.25.6-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /restaurant-mock ./cmd/restaurant-mock

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata wget

WORKDIR /app

COPY --from=builder /restaurant-mock .

EXPOSE 8081

ENV PORT=8081
ENV KITCHEN_CALLBACK_URL=http://kitchen-api:8080

ENTRYPOINT ["/app/restaurant-mock"]